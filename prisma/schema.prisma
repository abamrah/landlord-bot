generator client {
	provider = "prisma-client-js"
}

datasource db {
	provider = "postgresql"
	url      = env("DATABASE_URL")
}

enum MaintenanceStatus {
	OPEN
	PENDING
	IN_TRIAGE
	SCHEDULED
	IN_PROGRESS
	RESOLVED
	CANCELLED
}

enum Priority {
	CRITICAL
	HIGH
	NORMAL
	LOW
}

enum UtilityType {
	INTERNET
	WATER_GAS
	HYDRO
}

enum Plan {
	FREE
	PRO
	ENTERPRISE
}

enum UnitUtilityType {
	SINGLE
	SHARED
}

enum FinancialType {
	RENT_PAYMENT
	EXPENSE
	DEPOSIT
	REFUND
	OTHER
}

// ── Multi-landlord ──────────────────────────────────────

model Landlord {
	id               String   @id @default(cuid())
	email            String   @unique
	passwordHash     String
	name             String
	company          String?
	phone            String?
	whatsappNumbers        String[] @default([])
	evolutionInstanceName  String?
	plan             Plan     @default(FREE)
	stripeCustomerId String?
	stripeConnectAccountId  String?  // Stripe Connect Express account ID
	stripeConnectOnboarded  Boolean  @default(false)
	province         String   @default("ON")
	timezone         String   @default("America/Toronto")
	messageCountThisMonth Int @default(0)
	messageCountResetAt   DateTime @default(now())
	createdAt        DateTime @default(now())
	updatedAt        DateTime @updatedAt

	settings         LandlordSettings?
	properties       Property[]
	tenants          Tenant[]
	units            Unit[]
	financialRecords FinancialRecord[]
	contractors      Contractor[]
	requests         MaintenanceRequest[]
	utilityBills     UtilityBill[]
	utilityCredentials UtilityCredential[]
	greenButtonConnections GreenButtonConnection[]
	appSettings      AppSetting[]
	notifications    Notification[]
	pushSubscriptions PushSubscription[]
	rentPayments     RentPayment[]
	screenings       TenantScreening[]
	agentMemories    AgentMemory[]
}

model LandlordSettings {
	id                     String   @id @default(cuid())
	landlord               Landlord @relation(fields: [landlordId], references: [id])
	landlordId             String   @unique
	globalAutoReplyEnabled Boolean  @default(false)
	batchDelaySeconds      Int      @default(30)
	cooldownMinutes        Int      @default(5)
	autoReplyMaxSeverity   String   @default("normal")
	brandName              String?
	signatureLine          String?
	createdAt              DateTime @default(now())
	updatedAt              DateTime @updatedAt
}

// ── Existing models (now scoped to landlord) ────────────

model Tenant {
	id          String               @id @default(cuid())
	name        String
	phone       String?
	email       String?
	autoReplyEnabled Boolean          @default(true)
	stripeCustomerId String?          // Stripe customer ID for rent payments
	landlord    Landlord?            @relation(fields: [landlordId], references: [id])
	landlordId  String?
	units       UnitTenant[]
	requests    MaintenanceRequest[]
	utilityBills UtilityBill[]
	rentPayments RentPayment[]
	createdAt   DateTime             @default(now())
	updatedAt   DateTime             @updatedAt

	@@unique([phone, landlordId])
	@@unique([email, landlordId])
	@@index([landlordId])
	@@index([phone])
	@@index([email])
}

model AppSetting {
  id         String    @id @default(cuid())
  key        String
  value      String
  landlord   Landlord? @relation(fields: [landlordId], references: [id])
  landlordId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([key, landlordId])
}

model Property {
	id         String    @id @default(cuid())
	address    String
	landlord   Landlord? @relation(fields: [landlordId], references: [id])
	landlordId String?
	units      Unit[]
	createdAt  DateTime  @default(now())
	updatedAt  DateTime  @updatedAt

	@@index([landlordId])
}

model Unit {
	id               String               @id @default(cuid())
	label            String
	address          String               @default("")
	property         Property?            @relation(fields: [propertyId], references: [id])
	propertyId       String?
	utilityType      UnitUtilityType      @default(SINGLE)
	whatsappGroupJid String?
	landlord         Landlord?            @relation(fields: [landlordId], references: [id])
	landlordId       String?
	tenants          UnitTenant[]
	requests         MaintenanceRequest[]
	utilityBills     UtilityBill[]
	utilityCredentials UtilityCredential[]
	greenButtonConnections GreenButtonConnection[]
	reminders        Reminder[]
	createdAt        DateTime             @default(now())
	updatedAt        DateTime             @updatedAt

	@@index([landlordId])
	@@index([propertyId])
}

model UnitTenant {
	id                  String   @id @default(cuid())
	tenant              Tenant   @relation(fields: [tenantId], references: [id])
	tenantId            String
	unit                Unit     @relation(fields: [unitId], references: [id])
	unitId              String
	role                String   @default("tenant") // "tenant" | "resident"
	utilitySharePercent Float?
	rentAmountCents    Int?      // monthly rent in cents
	startDate           DateTime @default(now())
	endDate             DateTime?
	leaseDocuments      LeaseDocument[]
	rentPayments        RentPayment[]
}

// ── Lease Documents ─────────────────────────────────────

model LeaseDocument {
	id              String      @id @default(cuid())
	unitTenant      UnitTenant  @relation(fields: [unitTenantId], references: [id], onDelete: Cascade)
	unitTenantId    String
	fileName        String
	fileSize        Int         @default(0)
	mimeType        String      @default("application/pdf")
	fileData        Bytes?      // raw file bytes (optional — may store externally)
	extractedTerms  Json?       // AI-extracted structured terms (rent, dates, deposit, rules, etc.)
	fullText        String?     // Complete plain-text extraction of the entire lease document
	summary         String?     // AI-generated plain-text summary
	uploadedAt      DateTime    @default(now())

	@@index([unitTenantId])
}

model MaintenanceRequest {
	id             String            @id @default(cuid())
	tenant         Tenant?           @relation(fields: [tenantId], references: [id])
	tenantId       String?
	unit           Unit?             @relation(fields: [unitId], references: [id])
	unitId         String?
	landlord       Landlord?         @relation(fields: [landlordId], references: [id])
	landlordId     String?
	message        String
	status         MaintenanceStatus @default(OPEN)
	statusChangedAt DateTime          @default(now())
	priority       Priority          @default(NORMAL)
	category       String?
	triageJson     Json?
	aiDraft        Json?
	autopilotEnabled Boolean          @default(false)
	autopilotStatus String?
	autopilotLog  Json?
	chatLog        Json?
	landlordReply  String?
	autoReplyStatus String?
	autoReplyStatusAt DateTime?
	utilityAnomaly Boolean           @default(false)
	utilityNotes   String?
	mcpTaskId      String?
	createdAt      DateTime          @default(now())
	updatedAt      DateTime          @updatedAt
	utilityBills   UtilityBill[]

	@@index([status])
	@@index([landlordId])
}

model UtilityBill {
	id               String       @id @default(cuid())
	utilityType      UtilityType
	amountCents      Int
	currency         String        @default("CAD")
	usageAmount      Float?
	usageUnit        String?
	billingPeriodStart DateTime
	billingPeriodEnd DateTime
	statementUrl     String?
	portalUsername   String?
	anomalyFlag      Boolean      @default(false)
	anomalyNotes     String?
	rawData          Json?
	tenant           Tenant?      @relation(fields: [tenantId], references: [id])
	tenantId         String?
	unit             Unit?        @relation(fields: [unitId], references: [id])
	unitId           String?
	landlord         Landlord?    @relation(fields: [landlordId], references: [id])
	landlordId       String?
	maintenance      MaintenanceRequest? @relation(fields: [maintenanceId], references: [id])
	maintenanceId    String?
	createdAt        DateTime     @default(now())
	updatedAt        DateTime     @updatedAt

	@@index([landlordId])
}

model Contractor {
	id        String   @id @default(cuid())
	name      String
	phone     String   @unique
	email     String?
	role      String?
	specialties String[] @default([])
	active    Boolean  @default(true)
	landlord  Landlord? @relation(fields: [landlordId], references: [id])
	landlordId String?
	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt

	@@index([landlordId])
}

model UtilityCredential {
	id              String      @id @default(cuid())
	unit            Unit        @relation(fields: [unitId], references: [id])
	unitId          String
	landlord        Landlord?   @relation(fields: [landlordId], references: [id])
	landlordId      String?
	utilityType     UtilityType
	username        String?
	password        String?
	passwordEncrypted String?
	url             String?
	notes           String?
	createdAt       DateTime    @default(now())
	updatedAt       DateTime    @updatedAt

	@@index([landlordId])
}

// ── Conversation Memory ─────────────────────────────────

model ConversationMessage {
	id         String   @id @default(cuid())
	phone      String
	landlordId String?
	role       String   // "tenant" | "ai" | "landlord" | "system"
	content    String
	meta       Json?
	createdAt  DateTime @default(now())

	@@index([phone, landlordId])
	@@index([createdAt])
}

// ── Persistent Reminders ────────────────────────────────

model Reminder {
	id          String   @id @default(cuid())
	landlordId  String?
	unit        Unit?    @relation(fields: [unitId], references: [id])
	unitId      String?
	type        String   // "rent" | "utility"
	dayOfMonth  Int
	timeUtc     String
	style       String   // "short" | "medium" | "professional" | "casual"
	amountCents Int?     // optional pre-filled utility bill amount
	active      Boolean  @default(true)
	lastSentAt  DateTime?
	lastConfirmedAt DateTime?  // when tenant last confirmed payment for this cycle
	createdAt   DateTime @default(now())
	updatedAt   DateTime @updatedAt

	@@index([landlordId])
	@@index([active])
	@@index([unitId])
}

// ── Agent Token / Cost Tracking ─────────────────────────

model AgentUsage {
	id             String   @id @default(cuid())
	landlordId     String?
	model          String
	promptTokens   Int      @default(0)
	responseTokens Int      @default(0)
	totalTokens    Int      @default(0)
	toolCalls      Int      @default(0)
	taskType       String?  // "tenant-message" | "landlord-assistant" | "utility-check" etc.
	durationMs     Int      @default(0)
	createdAt      DateTime @default(now())

	@@index([landlordId])
	@@index([createdAt])
}

// ── Green Button Integration ────────────────────────────

model GreenButtonConnection {
	id             String   @id @default(cuid())
	provider       String   // "toronto_hydro" | "hydro_one" | "alectra" | "enbridge_gas"
	utilityType    UtilityType
	unit           Unit     @relation(fields: [unitId], references: [id])
	unitId         String
	landlord       Landlord? @relation(fields: [landlordId], references: [id])
	landlordId     String?
	accountNumber  String?  // Customer account number at the provider
	meterNumber    String?  // Meter ID (optional)
	// OAuth2 tokens (encrypted)
	accessToken    String?
	refreshToken   String?
	tokenExpiresAt DateTime?
	// Connection state
	status         String   @default("pending") // "pending" | "connected" | "error" | "expired"
	lastSyncAt     DateTime?
	lastError      String?
	// Green Button subscription details
	subscriptionId String?  // Green Button subscription UUID
	usagePointId   String?  // Green Button usage point href
	authorizationUrl String? // Stored for re-auth
	meta           Json?
	createdAt      DateTime @default(now())
	updatedAt      DateTime @updatedAt

	@@unique([provider, unitId, utilityType])
	@@index([landlordId])
	@@index([status])
}

// ── Notifications ───────────────────────────────────────

model Notification {
	id         String   @id @default(cuid())
	landlord   Landlord @relation(fields: [landlordId], references: [id], onDelete: Cascade)
	landlordId String
	type       String   // "maintenance" | "approval_request" | "contractor" | "lease" | "utility" | "system" | "info"
	title      String
	body       String
	data       Json?    // Optional structured data (maintenanceId, tenantPhone, severity, etc.)
	read       Boolean  @default(false)
	createdAt  DateTime @default(now())

	@@index([landlordId, read])
	@@index([landlordId, createdAt])
}

model PushSubscription {
	id         String   @id @default(cuid())
	landlord   Landlord @relation(fields: [landlordId], references: [id], onDelete: Cascade)
	landlordId String
	endpoint   String
	p256dh     String
	auth       String
	createdAt  DateTime @default(now())

	@@unique([landlordId, endpoint])
	@@index([landlordId])
}

// ── Financial Records / Ledger ──────────────────────────

model FinancialRecord {
	id              String        @id @default(cuid())
	landlord        Landlord      @relation(fields: [landlordId], references: [id], onDelete: Cascade)
	landlordId      String
	tenantName      String?
	tenantPhone     String?
	unitLabel       String?
	type            FinancialType @default(OTHER)
	amount          Float
	currency        String        @default("CAD")
	description     String?
	date            DateTime      @default(now())
	receiptData     Bytes?
	receiptMimeType String?
	createdAt       DateTime      @default(now())

	@@index([landlordId])
	@@index([landlordId, type])
	@@index([landlordId, date])
}

// ── Rent Payments (Stripe Connect) ──────────────────────

enum RentPaymentStatus {
	PENDING
	PROCESSING
	SUCCEEDED
	FAILED
	REFUNDED
	CANCELLED
}

model RentPayment {
	id                  String            @id @default(cuid())
	landlord            Landlord          @relation(fields: [landlordId], references: [id], onDelete: Cascade)
	landlordId          String
	tenant              Tenant            @relation(fields: [tenantId], references: [id])
	tenantId            String
	unitTenant          UnitTenant        @relation(fields: [unitTenantId], references: [id])
	unitTenantId        String
	amountCents         Int               // Rent amount in cents
	currency            String            @default("CAD")
	status              RentPaymentStatus @default(PENDING)
	stripePaymentIntentId String?         // Stripe PaymentIntent ID
	stripeChargeId      String?           // Stripe Charge ID
	stripeTransferId    String?           // Stripe Transfer to landlord's connected account
	platformFeeCents    Int               @default(0) // NestMind platform fee
	receiptUrl          String?           // Stripe receipt URL
	failureReason       String?
	dueDate             DateTime          // When the rent is due
	paidAt              DateTime?         // When the payment was completed
	periodStart         DateTime          // Billing period start
	periodEnd           DateTime          // Billing period end
	metadata            Json?
	createdAt           DateTime          @default(now())
	updatedAt           DateTime          @updatedAt

	@@index([landlordId])
	@@index([tenantId])
	@@index([status])
	@@index([dueDate])
}

// ── Agent Memory (persistent notes across conversations) ─

model AgentMemory {
	id         String   @id @default(cuid())
	landlord   Landlord @relation(fields: [landlordId], references: [id], onDelete: Cascade)
	landlordId String
	category   String   @default("general") // "preference", "tenant-note", "property-note", "procedure", "general"
	key        String                         // short label / topic identifier
	content    String                         // the actual memory content
	source     String   @default("agent")    // "agent" | "landlord" | "system"
	createdAt  DateTime @default(now())
	updatedAt  DateTime @updatedAt

	@@unique([landlordId, key])
	@@index([landlordId, category])
}

// ── Tenant Screening ────────────────────────────────────

enum ScreeningStatus {
	REQUESTED
	PENDING_CONSENT
	IN_PROGRESS
	COMPLETED
	FAILED
	EXPIRED
}

model TenantScreening {
	id                String          @id @default(cuid())
	landlord          Landlord        @relation(fields: [landlordId], references: [id], onDelete: Cascade)
	landlordId        String
	// Applicant info (may not be an existing tenant yet)
	applicantName     String
	applicantEmail    String?
	applicantPhone    String?
	unitId            String?         // The unit they're applying for
	// Screening details
	provider          String          @default("certn") // "certn" | "singlekey" | "manual"
	status            ScreeningStatus @default(REQUESTED)
	consentUrl        String?         // URL sent to applicant to consent to screening
	externalId        String?         // Provider's reference ID
	// Results (stored after completion)
	creditScore       Int?
	creditRating      String?         // "excellent" | "good" | "fair" | "poor"
	identityVerified  Boolean?
	criminalClear     Boolean?
	evictionHistory   Boolean?        // true = has eviction history
	incomeVerified    Boolean?
	monthlyIncome     Int?            // in cents
	riskScore         String?         // "low" | "medium" | "high"
	recommendation    String?         // "approve" | "conditional" | "decline"
	reportSummary     String?         // AI-generated summary of the screening result
	rawReport         Json?           // Full provider response
	// Timestamps
	requestedAt       DateTime        @default(now())
	consentedAt       DateTime?
	completedAt       DateTime?
	expiresAt         DateTime?       // Reports typically expire after 30 days
	createdAt         DateTime        @default(now())
	updatedAt         DateTime        @updatedAt

	@@index([landlordId])
	@@index([status])
	@@index([applicantEmail])
}